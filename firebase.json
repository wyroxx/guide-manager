{
  "hosting": {
    "target": "guides",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "tourapp-66e02",
          "appId": "1:551338757670:android:abd35ace9d25215b3ee0e7",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "tourapp-66e02",
          "appId": "1:551338757670:ios:9316df14c8e662633ee0e7",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "tourapp-66e02",
          "configurations": {
            "android": "1:551338757670:android:abd35ace9d25215b3ee0e7",
            "ios": "1:551338757670:ios:9316df14c8e662633ee0e7",
            "web": "1:551338757670:web:58a764b1a4ff65603ee0e7"
          }
        }
      }
    }
  }
}
